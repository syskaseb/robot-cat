<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="apartment_world">

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.75 0.80 0.85</background_color>
        <camera_pose>-4 -4 4 0 0.5 0.78</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Camera Controls">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui><property key="resizable" type="bool">false</property>
        <property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="height" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
      </plugin>
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="height" type="double">50</property>
          <property key="width" type="double">150</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
      </plugin>
      <!-- Preset viewpoints - top, front, side, home - plus a button that
           steps the camera 90 deg around the model. Docked rather than
           floating: all four corners of the 3D view are already claimed by
           the world control, stats, screenshot and transform widgets. -->
      <plugin filename="ViewAngle" name="View angle"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="ComponentInspector" name="Component inspector"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.32 0.20 1</ambient>
            <diffuse>0.55 0.38 0.23 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Open-plan kitchen/dining from Gazebo Fuel (OpenRobotics, CC0).
         Declared inline rather than <include>d because the upstream model is
         a visual mesh with no collision at all - the cat walked straight
         through the counters and the walls.

         The collisions below are boxes, not the mesh. Handing DART the
         57k-triangle mesh as a collision shape segfaults it outright
         (dart::collision::CollisionGroup::addShapeFrameImpl), and even if it
         held, a concave soup is the wrong shape to collide a walking robot
         against. The boxes are the axis-aligned bounds of the mesh's own
         sub-objects, keeping only pieces that are either thin (wall panels)
         or small-footprint and waist-high (furniture) - the bounds of a
         whole wall assembly are a lie, they enclose the floor between the
         walls and would seal the cat inside a solid block. -->
    <model name="kitchen_dining">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/kitchen and dining/3/files/meshes/kitchen_dining.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <!-- Perimeter, added by hand: the mesh's own outer walls survive
             filtering only in places, and without a closed boundary the cat
             walks off the edge of the apartment onto the bare ground plane. -->
        <collision name="wall_north">
          <pose>0 7.45 1.5 0 0 0</pose>
          <geometry><box><size>7.90 0.10 3.00</size></box></geometry>
        </collision>
        <collision name="wall_south">
          <pose>0 -7.45 1.5 0 0 0</pose>
          <geometry><box><size>7.90 0.10 3.00</size></box></geometry>
        </collision>
        <collision name="wall_west">
          <pose>-3.93 0 1.5 0 0 0</pose>
          <geometry><box><size>0.10 15.00 3.00</size></box></geometry>
        </collision>
        <collision name="wall_east">
          <pose>3.88 0 1.5 0 0 0</pose>
          <geometry><box><size>0.10 15.00 3.00</size></box></geometry>
        </collision>
        <collision name="c0">
          <pose>0.265 -2.160 0.470 0 0 0</pose>
          <geometry><box><size>1.219 3.200 1.029</size></box></geometry>
        </collision>
        <collision name="c1">
          <pose>-3.257 -1.065 0.288 0 0 0</pose>
          <geometry><box><size>0.784 2.649 0.580</size></box></geometry>
        </collision>
        <collision name="c2">
          <pose>1.086 2.009 0.288 0 0 0</pose>
          <geometry><box><size>1.300 1.156 0.580</size></box></geometry>
        </collision>
        <collision name="c3">
          <pose>-2.976 6.471 0.472 0 0 0</pose>
          <geometry><box><size>1.143 1.152 0.630</size></box></geometry>
        </collision>
        <collision name="c4">
          <pose>-0.525 5.138 0.360 0 0 0</pose>
          <geometry><box><size>1.372 0.889 0.724</size></box></geometry>
        </collision>
        <collision name="c5">
          <pose>-3.337 -2.859 0.309 0 0 0</pose>
          <geometry><box><size>0.925 0.918 0.752</size></box></geometry>
        </collision>
        <collision name="c6">
          <pose>-0.081 1.770 0.271 0 0 0</pose>
          <geometry><box><size>1.036 0.613 0.679</size></box></geometry>
        </collision>
        <collision name="c7">
          <pose>-2.127 1.344 0.295 0 0 0</pose>
          <geometry><box><size>3.044 0.173 0.724</size></box></geometry>
        </collision>
        <collision name="c8">
          <pose>-3.753 -2.194 1.999 0 0 0</pose>
          <geometry><box><size>0.116 3.764 2.684</size></box></geometry>
        </collision>
        <collision name="c9">
          <pose>-1.470 -4.904 2.131 0 0 0</pose>
          <geometry><box><size>2.145 0.186 0.697</size></box></geometry>
        </collision>
        <collision name="c10">
          <pose>-1.470 -4.904 1.170 0 0 0</pose>
          <geometry><box><size>2.145 0.186 0.840</size></box></geometry>
        </collision>
        <collision name="c11">
          <pose>-2.738 6.795 -0.011 0 0 0</pose>
          <geometry><box><size>0.658 0.560 0.338</size></box></geometry>
        </collision>
        <collision name="c12">
          <pose>-3.261 6.178 -0.011 0 0 0</pose>
          <geometry><box><size>0.658 0.560 0.338</size></box></geometry>
        </collision>
        <collision name="c13">
          <pose>-1.554 7.226 1.670 0 0 0</pose>
          <geometry><box><size>2.037 0.126 3.343</size></box></geometry>
        </collision>
        <collision name="c14">
          <pose>-1.554 7.291 1.670 0 0 0</pose>
          <geometry><box><size>2.037 0.081 3.343</size></box></geometry>
        </collision>
        <collision name="c15">
          <pose>0.724 7.291 1.670 0 0 0</pose>
          <geometry><box><size>1.974 0.081 3.343</size></box></geometry>
        </collision>
        <collision name="c16">
          <pose>-3.755 4.985 1.670 0 0 0</pose>
          <geometry><box><size>0.075 1.882 3.343</size></box></geometry>
        </collision>
        <collision name="c17">
          <pose>1.410 -3.181 1.102 0 0 0</pose>
          <geometry><box><size>0.170 0.443 0.260</size></box></geometry>
        </collision>
        <collision name="c18">
          <pose>1.400 -1.610 1.102 0 0 0</pose>
          <geometry><box><size>0.170 0.443 0.260</size></box></geometry>
        </collision>
        <collision name="c19">
          <pose>1.440 -2.376 1.102 0 0 0</pose>
          <geometry><box><size>0.170 0.443 0.260</size></box></geometry>
        </collision>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/sofa</uri>
      <name>living_room_sofa</name>
      <pose>2 -3 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>

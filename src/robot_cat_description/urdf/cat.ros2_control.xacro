<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control wiring plus the Gazebo plugin that backs it.

       Every joint exposes a position command interface; the gait node drives
       all twelve through position_controllers/JointGroupPositionController.
       Using ros2_control rather than Gazebo's own joint-position plugin means
       the same gait node can later drive real hardware by swapping only the
       <hardware> block. -->

  <xacro:macro name="joint_control" params="name">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="leg_control" params="prefix">
    <xacro:joint_control name="${prefix}_hip_joint"/>
    <xacro:joint_control name="${prefix}_thigh_joint"/>
    <xacro:joint_control name="${prefix}_calf_joint"/>
  </xacro:macro>

  <xacro:macro name="cat_ros2_control" params="controllers_file">

    <ros2_control name="RobotCatGazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:leg_control prefix="fl"/>
      <xacro:leg_control prefix="fr"/>
      <xacro:leg_control prefix="rl"/>
      <xacro:leg_control prefix="rr"/>
      <xacro:joint_control name="neck_pan_joint"/>
      <xacro:joint_control name="head_tilt_joint"/>
      <xacro:joint_control name="tail_joint"/>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>

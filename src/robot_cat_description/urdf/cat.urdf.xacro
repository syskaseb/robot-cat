<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_cat">

  <!-- A 12-DOF quadruped "cat": box body, four 3-DOF legs, cosmetic head and
       tail. Built from primitives so it is easy to swap for real geometry
       later - replace the <geometry> blocks and the dimensions below. -->

  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="controllers_file" default=""/>

  <!-- ==================== scale ====================
       One knob for the whole animal. Every length below is a base dimension
       multiplied by this; masses go as scale^3 and joint effort as scale^4,
       which is how joint torque actually scales (mass x lever arm).

       1.00 is the robot that gets built: 24.2 cm at the withers against a
       live cat's 24, and 2.1 kg of servos, printed shell, battery and
       electronics. Nothing needs multiplying to get there, and the ST3215
       torque limit below is only true at this scale.

       Scale is not a cosmetic choice, it picks an actuator class. Torque
       goes as roughly the 3.5 power of size, so an animal that merely looks
       bigger costs several times the motor and leaves the ST3215 class
       entirely. Anything other than 1.00 needs its own torque measurement
       before it means anything. -->
  <xacro:arg name="scale" default="1.0"/>
  <xacro:property name="scale" value="$(arg scale)"/>

  <!-- Construction weight, separate from size. The masses below are the
       parts list, so 1.0 is the robot as specified and needs no correction.
       The knob exists to ask what a heavier or lighter build would cost in
       torque: it tracks mass almost linearly in a quasi-static walk, which
       makes it the cheapest lever there is on actuator class. The obvious
       use is checking the PETG estimate - the shell is 700 g of the 2.1 kg
       and is the one figure nobody has weighed yet. -->
  <xacro:arg name="mass_scale" default="1.0"/>
  <xacro:property name="mass_scale" value="$(arg mass_scale)"/>

  <!-- ==================== dimensions ====================
       These MUST match LegGeometry in robot_cat_gait/leg_ik.py. If you change
       a length here, change it there too, or the gait will command feet to
       places the legs cannot reach. -->
  <xacro:property name="hip_offset"   value="${0.025 * scale}"/>  <!-- hip roll -> thigh pitch, lateral -->
  <!-- A cat is close to square in profile - it stands about as tall at the
       shoulder as its trunk is long. 0.11 puts the hip 17.2 cm up and the
       withers at 24.2 cm over a 22 cm hip span, and holds the standing knee
       at 73% of full reach, which is what gives the gait its bend and its
       swing clearance. Segment length and stance_height move together:
       raising one alone straightens the knee towards a locked leg. -->
  <xacro:property name="thigh_length" value="${0.11 * scale}"/>   <!-- L1 -->
  <xacro:property name="calf_length"  value="${0.11 * scale}"/>   <!-- L2 -->
  <xacro:property name="foot_radius"  value="${0.012 * scale}"/>

  <!-- A cat's trunk is deeper than it is wide - chest girth of about
       38 cm works out near 14 cm deep by 10 cm across - so the box is
       length : width : depth = 1 : 0.37 : 0.47. Keep it that way round: a
       trunk wider than it is deep reads as a slab on legs, not an animal. -->
  <xacro:property name="body_length" value="${0.30 * scale}"/>
  <xacro:property name="body_width"  value="${0.111 * scale}"/>
  <xacro:property name="body_height" value="${0.141 * scale}"/>

  <!-- Hip joint placement relative to body centre. -->
  <xacro:property name="hip_x" value="${0.11 * scale}"/>
  <xacro:property name="hip_y" value="${0.055 * scale}"/>

  <!-- ==================== masses ====================
       These are the parts list, not a scaled animal, and they sum to the
       2.095 kg budget in docs/napedy-v4.pdf. Where each part physically
       sits decides which link carries it, and the servos dominate: twelve
       ST3215 at 69 g are 828 g of the total.

       The roll servo is bolted to the trunk, so its mass is base_link's.
       hip_link carries the thigh pitch servo it swings, thigh_link carries
       the knee servo at the knee, and calf_link is unpowered - printed
       segment, paw pad and the wiring crossing it. That makes the lower leg
       light, which is what a swing leg wants.

           base_link  1042 g   4 roll servos, battery, Pi 5 + AI HAT+,
                               trunk shell, converters, wiring
           head         80 g   shell, camera, IR illuminator, 2 microservos
           tail         27 g   shell and its microservo
           per leg     234 g   88 hip + 109 thigh + 37 calf

       Head and tail are actuated, not fixed, so their mass hangs off the
       trunk on a long lever instead of being lumped into it by SDF
       conversion - exactly where it disturbs pitch most. They are damped
       stiffly below so they settle rather than swing. -->
  <xacro:property name="body_mass"  value="${1.042 * scale**3 * mass_scale}"/>
  <xacro:property name="head_mass"  value="${0.080 * scale**3 * mass_scale}"/>
  <xacro:property name="neck_mass"  value="${0.010 * scale**3 * mass_scale}"/>
  <xacro:property name="tail_mass"  value="${0.027 * scale**3 * mass_scale}"/>
  <xacro:property name="hip_mass"   value="${0.088 * scale**3 * mass_scale}"/>
  <xacro:property name="thigh_mass" value="${0.109 * scale**3 * mass_scale}"/>
  <xacro:property name="calf_mass"  value="${0.037 * scale**3 * mass_scale}"/>

  <!-- Head and tail joints. Damped far stiffer than the legs: they are meant
       to hold a pose, and any wobble here feeds straight back into the trunk.

       Effort and velocity are a metal-gear microservo of the class the parts
       list budgets for - the plan names three of them but not a model, so
       0.20 Nm is the conservative end of that class rather than a datasheet
       figure. It is ample either way: the head is 80 g on a 3 cm lever, so
       holding it up takes 0.024 Nm. -->
  <xacro:property name="trim_damping"  value="0.4"/>
  <xacro:property name="trim_effort"   value="${0.20 * scale**4}"/>
  <xacro:property name="trim_velocity" value="8.0"/>

  <!-- ==================== joint properties ====================
       Ranges are deliberately generous for the pitch joints so the gait has
       headroom, but the knee is restricted to one bending direction to match
       the IK branch (knee_sign = -1 in leg_ik.py). -->
  <xacro:property name="hip_range"      value="0.80"/>
  <xacro:property name="thigh_lower"    value="-1.20"/>
  <xacro:property name="thigh_upper"    value="2.60"/>
  <xacro:property name="calf_lower"     value="-2.70"/>
  <xacro:property name="calf_upper"     value="-0.10"/>

  <!-- The actuator is a Waveshare ST3215, and these are its numbers, not
       headroom picked to make the simulation behave.

       Effort is stall torque at the *worst* battery state. The datasheet
       30 kg.cm is quoted at 12 V and a DC motor's stall torque tracks
       voltage, so a 3S pack gives 3.08 Nm freshly charged and 2.57 Nm by the
       time it is nearly flat. Sizing on 2.57 means the cat does not get
       weaker than the simulation as the battery drains. The walk needs
       1.93 Nm at the 95th percentile, so this is about 33% margin.

       Velocity is the no-load figure, 0.222 s/60 degrees at 12 V. The gait
       peaks near 2.8 rad/s, so it fits, but not by so much that a faster
       cycle time is free.

       Effort keeps the scale^4 factor because required torque scales that
       way; the ST3215 itself does not, so any scale but 1.00 has left this
       actuator behind. Velocity is unscaled - a servo turns at the speed it
       turns regardless of how big the animal around it is. -->
  <xacro:property name="joint_effort"   value="${2.57 * scale**4}"/>
  <xacro:property name="joint_velocity" value="4.7"/>
  <xacro:property name="joint_damping"  value="0.05"/>
  <xacro:property name="joint_friction" value="0.01"/>
  <xacro:property name="foot_mu"        value="1.2"/>

  <xacro:include filename="$(find robot_cat_description)/urdf/inertia.xacro"/>
  <xacro:include filename="$(find robot_cat_description)/urdf/leg.xacro"/>

  <material name="cat_fur">    <color rgba="0.45 0.38 0.34 1.0"/></material>
  <material name="cat_accent"> <color rgba="0.25 0.22 0.20 1.0"/></material>
  <material name="cat_paw">    <color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="cat_nose">   <color rgba="0.85 0.55 0.60 1.0"/></material>
  <material name="cat_eye">    <color rgba="0.92 0.90 0.55 1.0"/></material>
  <material name="cat_pupil">  <color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ==================== body ==================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="cat_fur"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:box_inertia mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- Head: two actuated DOF (pan, tilt) driven by head_position_controller
       from the W/A/S/D keys - see robot_cat_teleop/head.py. neck_link is a
       near-massless intermediate body so pan and tilt are independent
       revolute joints rather than one compound one; ros2_control needs each
       DOF as its own joint. -->
  <joint name="neck_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="neck_link"/>
    <origin xyz="${body_length/2} 0 ${body_height/2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="${trim_effort}" velocity="${trim_velocity}"/>
    <dynamics damping="${trim_damping}" friction="${joint_friction}"/>
  </joint>
  <link name="neck_link">
    <xacro:box_inertia mass="${neck_mass}" x="${0.02 * scale}" y="${0.02 * scale}" z="${0.02 * scale}"/>
  </link>

  <joint name="head_tilt_joint" type="revolute">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin xyz="${0.03 * scale} 0 0" rpy="0 0 0"/>
    <!-- Axis is -Y, not +Y: with the head extending along local +X, a
         positive rotation about +Y points the nose down, which is backwards
         from "positive tilt = look up" used by the tilt_lower/tilt_upper
         convention below and by robot_cat_teleop. -->
    <axis xyz="0 -1 0"/>
    <limit lower="-0.3" upper="0.5" effort="${trim_effort}" velocity="${trim_velocity}"/>
    <dynamics damping="${trim_damping}" friction="${joint_friction}"/>
  </joint>
  <link name="head_link">
    <visual>
      <geometry><sphere radius="${0.05 * scale}"/></geometry>
      <material name="cat_fur"/>
    </visual>
    <visual>
      <origin xyz="${0.045 * scale} 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${0.012 * scale}"/></geometry>
      <material name="cat_nose"/>
    </visual>
    <!-- Eyes. Cosmetic here, but the pair is where the real hardware goes, so
         keep the origins: one eye is the camera, the other is its infrared
         illuminator.

         Only one of them is a camera. Stereo exists solely to recover depth,
         and docs/plan-zakupowy.pdf takes depth from a VL53L5CX time-of-flight
         sensor instead: two camera modules would need syncing and calibrating
         on a machine that shakes as it walks, and the other socket is spoken
         for by the illuminator. The Pi 5 does have two CSI ports, so stereo
         stays physically possible - it is just not what the depth comes from.

         The camera is the *NoIR* variant - no infrared cut filter, so it sees
         the illuminator and the cat can see in the dark. That costs correct
         daylight colour, which is the trade being made deliberately.

         Mount only the camera sensor at one of these origins and the
         simulated view will match the real one. Gazebo cannot run camera
         sensors on macOS at all - Cocoa requires render window creation on
         the main thread (gazebosim/gz-sim#960) - so that work happens in the
         Docker path. -->
    <xacro:property name="eye_x" value="${0.036 * scale}"/>
    <xacro:property name="eye_y" value="${0.022 * scale}"/>
    <xacro:property name="eye_z" value="${0.018 * scale}"/>
    <xacro:macro name="cat_eye" params="side y_sign">
      <visual name="eye_${side}">
        <origin xyz="${eye_x} ${y_sign * eye_y} ${eye_z}" rpy="0 0 0"/>
        <geometry><sphere radius="${0.010 * scale}"/></geometry>
        <material name="cat_eye"/>
      </visual>
      <visual name="pupil_${side}">
        <!-- Sits just proud of the eyeball so it renders in front of it
             rather than z-fighting with the white. -->
        <origin xyz="${eye_x + 0.007 * scale} ${y_sign * eye_y} ${eye_z}" rpy="0 0 0"/>
        <geometry><sphere radius="${0.005 * scale}"/></geometry>
        <material name="cat_pupil"/>
      </visual>
    </xacro:macro>
    <xacro:cat_eye side="left"  y_sign="1"/>
    <xacro:cat_eye side="right" y_sign="-1"/>

    <!-- ears -->
    <visual>
      <origin xyz="${-0.01 * scale} ${0.028 * scale} ${0.042 * scale}" rpy="0 0 0"/>
      <geometry><box size="${0.02 * scale} ${0.012 * scale} ${0.035 * scale}"/></geometry>
      <material name="cat_accent"/>
    </visual>
    <visual>
      <origin xyz="${-0.01 * scale} ${-0.028 * scale} ${0.042 * scale}" rpy="0 0 0"/>
      <geometry><box size="${0.02 * scale} ${0.012 * scale} ${0.035 * scale}"/></geometry>
      <material name="cat_accent"/>
    </visual>
    <xacro:box_inertia mass="${head_mass}" x="${0.1 * scale}" y="${0.1 * scale}" z="${0.1 * scale}"/>
  </link>

  <!-- Tail: one actuated DOF, stepped by the space bar - see
       robot_cat_teleop/tail.py. The -0.9 rad pitch in the origin is the rest
       pose, tail up and back; the joint angle is measured from there, so
       positive raises towards vertical and negative droops it down. -->
  <joint name="tail_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tail_link"/>
    <origin xyz="${-body_length/2 - 0.04 * scale} 0 ${body_height/2}" rpy="0 -0.9 0"/>
    <axis xyz="0 1 0"/>
    <!-- Wider than the sweep TailParams actually uses, so the controller
         settles on its target instead of pushing against the joint stop. -->
    <limit lower="-1.4" upper="1.0" effort="${trim_effort}" velocity="${trim_velocity}"/>
    <dynamics damping="${trim_damping}" friction="${joint_friction}"/>
  </joint>
  <link name="tail_link">
    <visual>
      <origin xyz="0 0 ${0.04 * scale}" rpy="0 0 0"/>
      <geometry><cylinder radius="${0.009 * scale}" length="${0.12 * scale}"/></geometry>
      <material name="cat_accent"/>
    </visual>
    <xacro:cylinder_inertia mass="${tail_mass}" radius="${0.009 * scale}" length="${0.12 * scale}"/>
  </link>

  <!-- ==================== legs ====================
       Joint order fl, fr, rl, rr is the contract with the gait node and
       controllers.yaml. Do not reorder without changing both. -->
  <xacro:cat_leg prefix="fl" x_sign="1"  y_sign="1"/>
  <xacro:cat_leg prefix="fr" x_sign="1"  y_sign="-1"/>
  <xacro:cat_leg prefix="rl" x_sign="-1" y_sign="1"/>
  <xacro:cat_leg prefix="rr" x_sign="-1" y_sign="-1"/>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find robot_cat_description)/urdf/cat.ros2_control.xacro"/>
    <xacro:cat_ros2_control controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>

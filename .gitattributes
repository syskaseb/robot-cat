# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Shell scripts must stay LF even when checked out on Windows. Git's autocrlf
# would otherwise hand them CRLF, and every one of them is executed by bash -
# in WSL, or inside the Linux container run/docker/ builds - where a trailing
# \r turns the shebang into "/usr/bin/env bash\r: no such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf

# Generated PDFs are binary even when their first block contains no NUL byte.
*.pdf binary

# Simulation provenance hashes must survive Windows/Linux checkouts.
tools/simulation/*.py text eol=lf
tools/simulation/plugin/* text eol=lf

# v33 evidence is checksummed byte-for-byte. Preserve OCCT's serialized BRep
# (including kernel whitespace), and keep hashed JSON stable across platforms.
hardware/skorupa/v33/recovery/*.brep binary
hardware/skorupa/v33/*.json text eol=lf

# v35 prototype decisions bind the raw JSON evidence with SHA256 as well as
# binary CAD. Windows checkout must not invalidate these evidence chains.
hardware/skorupa/v35/*.json text eol=lf
hardware/skorupa/v35/rejected/*.json text eol=lf
hardware/simulation/v35/*.json text eol=lf
hardware/simulation/v35/trials/*.json text eol=lf
